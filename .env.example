# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything here is optional: the site builds and works without them (with the fallbacks noted).

# ── Contact form (Resend, https://resend.com) ────────────────────────────────
# Without RESEND_API_KEY the form opens the visitor's email app instead of sending.
RESEND_API_KEY=""                     # TODO(Yashasvi): paste your Resend API key
CONTACT_TO_EMAIL=ysorapalli@gmail.com
# Must be a sender on a domain you verified in Resend (e.g. hello@ysorapalli.com).
# "onboarding@resend.dev" works for testing but only delivers to your Resend account email.
CONTACT_FROM_EMAIL="onboarding@resend.dev"   # TODO(Yashasvi): switch to your verified sender

# ── GitHub shelf ─────────────────────────────────────────────────────────────
# Public data works without a token; a token only raises the rate limit.
GITHUB_TOKEN=""                       # optional: fine-grained token, public read-only
